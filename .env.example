# ===================================================
# Godfather Bot Environment Configuration Template
# Duplicate this file to '.env' and fill in the values
# ===================================================

# Telegram Bot Token (obtained from @BotFather)
BOT_TOKEN=123456789:ABCdefGhIJKlmNoPQRsTUVwxyZ_1234567

# Database Connection URL (SQLite or PostgreSQL)
DATABASE_URL=sqlite+aiosqlite:///godfather.db

# Admin User IDs (comma-separated integer Telegram IDs)
ADMIN_IDS=123456789,987654321

# Bot Creator / Owner Telegram ID
CREATOR_ID=123456789

# Admin Panel Password
ADMIN_PASSWORD=change_this_to_a_strong_password

# Telegram Channel IDs for Logs & Archives
ARCHIVE_CHANNEL_ID=-1001234567890
NEWS_CHANNEL_ID=-1001234567890
